{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "platform/index.js",
    "*/main.jsx",
    "dam/app/assets.jsx",
    "build-*.js",
    "build-packages.d/*.js",
    "check-*.js",
    // check-system.js loads these through readdir
    "check-system.rules/*.js",
    "tokenize-component.js",
    "tests/**/*.js",
    "tools/**/*.js",
    // checks run by node and tests run by vitest or Playwright (P0-8)
    "tools/checks/**/*.mjs",
    "tests/*/*.mjs",
    "services/**/*.js",
    // run by hand from a runbook: services/login/README.md ("with services/auth/npm-advanced-config.mjs, dry run first")
    "services/auth/*.mjs",
    // run by deploy/agents/team.sh (schedule, #246)
    "deploy/agents/*.mjs",
    // the release tools, run by hand at a release or by release.yml (#194, #312)
    "tools/publish/*.mjs",
    // run by npm run tokens:sd:check (slice 101, #372 steps 5 to 7)
    "style-dictionary/build.mjs",
    // a proof tool run by hand (the other proof folders moved to the archive, docs/ARCHIVE.md)
    "tests/ci197-*.cjs",
    // loaded by script tags in pages
    "platform/dev/*.js",
    "platform/providers/theme-boot.js",
    // loaded by script tags in pages; check-system.rules/icon-names.js reads it
    "suite/plenix-app-data.js",
    "suite/settings-data.js",
    // loaded by script tags in the pages: each app's icon file, the engines and the icon uses
    "*/plenix-icons-*.js",
    "platform/engines/plenix-engines.js",
    // every application page loads it first, by a script tag (issue 842)
    "platform/loader/loader.js",
    "platform/icons/uses.js",
    // the PDS 1.0 dashboard page loads it by a script tag (dashboard/pds1/index.html, D-0034)
    "dashboard/pds1/app.js",
    // run by node build-packages.js through the Vite command line (#709 step 5); the Arabic opt-in is one of its entries
    "vite.packages.config.mjs",
    "platform/i18n/ar.optin.js"
  ],
  "project": ["**/*.{js,jsx,ts,tsx,mjs,cjs}"],
  // the build resolves this name to the script already on the page
  // paper and paperjs-offset are installed for the icon tools only: npm install --prefix tools/icons (tools/icons/package.json)
  // @plenix-ds/lint is loaded by tools/baseline/scan.js only when it is installed beside the app or here; the scan has its own copy of the rules otherwise
  // the packages/* workspaces are manifests only until their source moves in (#183, docs/adr/0001): nothing to analyse yet
  "ignoreWorkspaces": ["packages/*"],
  "ignoreDependencies": ["plenix-platform", "paper", "paperjs-offset", "@plenix-ds/lint"],
  // written by build-packages.js into the package it builds; ./icon-names.js is the npm package's lazy icon-name chunk, which
  // vite.packages.config.mjs (plenix-icon-names) writes for tools/npm-esm/library.js
  "ignoreUnresolved": ["./check-copy.js", "./index.cjs", "./icon-names.js"],
  // exports used in ways Knip cannot see (a namespace, a dynamic import in a test, text read by a build or a check)
  "ignoreIssues": {
    // used as layout.<name> by build-icons.js, build-packages.js, build-app.js, tests and tools/icons
    "platform/icons/layout.js": ["exports"],
    // groupedRows: imported by tests/data-grid-group-165.test.js with a dynamic import
    "platform/components/DataGrid/records.js": ["exports"],
    // matchesCondition: used as fields.matchesCondition by tests/date-only.test.js
    "platform/utils/fields.ts": ["exports"],
    // the utilities' exported types are their typed API (#708): the next slices and the generated definitions use them
    "platform/utils/*.{ts,tsx}": ["types"],
    // every converted part exports its <Name>Props type (ADR 0011, #369): the generated declarations of wave 5 expose them; platform/index.js cannot re-export a type
    "platform/{components,patterns}/**/*.tsx": ["types"],
    // generated by build-standards.js (the generator writes the export)
    "platform/providers/pageLayouts.js": ["exports"],
    // monitorKey: check-system.rules/monitor-widths.js requires the export in the file's text
    "platform/utils/monitorWidths.ts": ["exports"],
    // RICH_TEXT_STYLE_PROPERTIES: a public re-export apps may read (owner of the decision: Tech Lead)
    "platform/components/RichTextEditor/RichTextEditor.jsx": ["exports"]
  },
  "ignore": [
    // Opengrep rule fixtures (.opengrep/rules/*.fixture.tsx): read by `opengrep test`, never imported or built (#197)
    ".opengrep/**",
    // the app tests/baseline-scan-273.test.js and tools/baseline/scan.js read as text: nothing imports it
    "tests/fixtures/baseline-app/**",
    "platform/dist/**",
    "*/app.js",
    "dam/app/assets.js",
    "platform/vendor/**",
    "platform/design-system/**",
    // hand-owned lane sources: build-exports.js reads them as text, so nothing imports them. Never delete.
    "platform/exports/**",
    // generated by tools/icons/build-inventory.js; loaded by pages
    "platform/icons/inventory/inventory.js",
    "docs/**",
    "tools/agent/**",
    // the open-source vote kit is a package of its own (vote-kit/package.json, vote-kit/README.md), used by the apps that adopt it
    "vote-kit/**"
  ]
}
