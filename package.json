{
  "name": "plenix",
  "version": "0.90.2",
  "private": true,
  "description": "Plenix Platform: the design system, component library and apps",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "node build-app.js",
    "build:app": "node build-app.js && node build-usage.js",
    "lint:system": "node check-system.js",
    "lint:style": "node check-style.js",
    "lint:spec": "node check-spec.js",
    "build:docs": "node build-docs.js",
    "build:packages": "node build-packages.js",
    "tokens:sd:check": "node style-dictionary/build.mjs --sets && node style-dictionary/build.mjs --bytes",
    "tokens:index": "node tools/token-index.js",
    "release:build": "node build-app.js && node build-usage.js && node check-system.js && node check-style.js && node build-packages.js",
    "test": "node tests/run.js",
    "test:full": "node tests/run.js --full",
    "test:on-demand": "node tests/run.js --on-demand",
    "test:on-demand:full": "node tests/run.js --on-demand --full",
    "test:scope": "node tests/changed.js",
    "test:visual": "node tests/visual.test.js",
    "test:pages": "node tests/pages.test.js",
    "test:a11y": "node tests/a11y.test.js",
    "test:keyboard": "node tests/keyboard.test.js",
    "test:layout": "node tests/layout.test.js",
    "test:theme": "node tests/theme.test.js",
    "test:density": "node tests/density.test.js",
    "test:component-tokens": "node tests/component-tokens.test.js",
    "test:site-coverage": "node tests/site-coverage.test.js",
    "test:site-parts": "node tests/site-parts.test.js",
    "test:reflow": "node tests/reflow.test.js",
    "test:typography": "node tests/typography.test.js",
    "test:login": "node tests/login.test.js",
    "test:contrast": "node tests/contrast.test.js",
    "test:formats": "node tests/formats.test.js",
    "test:utilities": "node tests/utilities.test.js",
    "test:high-contrast": "node tests/high-contrast.test.js",
    "test:focus-order": "node tests/focus-order.test.js",
    "test:semantic-html": "node tests/semantic-html.test.js",
    "test:brand-rules": "node tests/brand-rules.test.js",
    "test:data-grid": "node tests/data-grid.test.js",
    "test:navigation": "node tests/navigation.test.js",
    "test:types": "node tests/types.test.js",
    "lint:css": "stylelint \"platform/**/*.css\" \"services/**/*.css\"",
    "lint:js": "eslint --no-error-on-unmatched-pattern platform suite dam/app dashboard projects messages contacts calendar tasks notes bookmarks files settings lanes",
    "lint:unused": "knip --no-exit-code",
    "lint:bundle": "node check-bundle.js",
    "typecheck": "tsc --noEmit",
    "build:workspaces": "npm run build --workspaces",
    "changeset": "changeset",
    "tokens:build": "node style-dictionary/build.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o build/storybook",
    "prebuild-storybook": "node build-app.js",
    "prestorybook": "node build-app.js"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@babel/standalone": "^7.29.9",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-highlight": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-list": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extension-subscript": "3.31.3",
    "@tiptap/extension-superscript": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-typography": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/parser": "8.71.2",
    "axe-core": "4.10.3",
    "esbuild": "0.25.10",
    "eslint": "9.39.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "knip": "^6.43.0",
    "postcss": "^8.5.32",
    "puppeteer-core": "25.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.6.6",
    "style-dictionary": "5.7.0",
    "stylelint": "^17.16.0",
    "typescript": "5.6.3",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21"
  }
}
