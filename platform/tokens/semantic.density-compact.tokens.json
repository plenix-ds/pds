{
  "$description": "semantic tokens written under [data-plx-density=\"compact\"],:root[data-plx-density-policy=\"compact\"]:not([data-plx-density])",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": "[data-plx-density=\"compact\"],:root[data-plx-density-policy=\"compact\"]:not([data-plx-density])",
      "opener": "[data-plx-density=\"compact\"],:root[data-plx-density-policy=\"compact\"]:not([data-plx-density]){"
    }
  },
  "plx-sys": {
    "radius-control": {
      "$value": "{plx-sys.radius-control-4px}",
      "$type": "dimension"
    },
    "control-height-inline": {
      "$value": "{plx-ref.control-size-6u}",
      "$type": "dimension"
    },
    "control-icon-inline": {
      "$value": "{plx-ref.size-4u}",
      "$type": "dimension"
    },
    "control-height-toolbar": {
      "$value": "{plx-ref.control-size-6u}",
      "$type": "dimension"
    },
    "control-icon-toolbar": {
      "$value": "{plx-ref.size-4u}",
      "$type": "dimension"
    },
    "control-height-standard": {
      "$value": "{plx-ref.control-size-6u}",
      "$type": "dimension"
    },
    "control-icon-standard": {
      "$value": "{plx-ref.size-4u}",
      "$type": "dimension"
    },
    "control-height-prominent": {
      "$value": "{plx-ref.control-size-8u}",
      "$type": "dimension"
    },
    "control-icon-prominent": {
      "$value": "{plx-ref.size-6u}",
      "$type": "dimension"
    },
    "control-height-dialog": {
      "$value": "{plx-ref.control-size-9u}",
      "$type": "dimension"
    },
    "control-icon-dialog": {
      "$value": "{plx-ref.size-5u}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "control-height-dialog-destructive": {
      "$value": "{plx-ref.control-size-9u}",
      "$type": "dimension"
    },
    "control-icon-dialog-destructive": {
      "$value": "{plx-ref.size-5u}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "card-grid-gap": {
      "$value": "{plx-ref.space-3u}",
      "$type": "dimension"
    },
    "grid-gutter": {
      "$value": "{plx-ref.grid-gutter-sm}",
      "$type": "dimension"
    },
    "page-margin-desktop": {
      "$value": "{plx-ref.grid-margin-md}",
      "$type": "dimension"
    },
    "page-margin-wide": {
      "$value": "{plx-ref.grid-margin-md}",
      "$type": "dimension"
    },
    "panel-filter-width": {
      "$value": "{plx-ref.size-70u}",
      "$type": "dimension"
    },
    "panel-inspector-width": {
      "$value": "{plx-ref.size-80u}",
      "$type": "dimension"
    },
    "space-component-gap-xs": {
      "$value": "{plx-ref.space-1u}",
      "$type": "dimension"
    },
    "space-component-gap-sm": {
      "$value": "{plx-ref.space-1u}",
      "$type": "dimension"
    },
    "space-component-gap-md": {
      "$value": "{plx-ref.space-2u}",
      "$type": "dimension"
    },
    "space-component-gap-lg": {
      "$value": "{plx-ref.space-3u}",
      "$type": "dimension"
    },
    "space-container-inset-sm": {
      "$value": "{plx-ref.space-2u}",
      "$type": "dimension"
    },
    "space-container-inset-md": {
      "$value": "{plx-ref.space-3u}",
      "$type": "dimension"
    },
    "space-container-inset-lg": {
      "$value": "{plx-ref.space-4u}",
      "$type": "dimension"
    },
    "space-pattern-stack-sm": {
      "$value": "{plx-ref.space-2u}",
      "$type": "dimension"
    },
    "space-pattern-stack-md": {
      "$value": "{plx-ref.space-3u}",
      "$type": "dimension"
    },
    "space-pattern-stack-lg": {
      "$value": "{plx-ref.space-4u}",
      "$type": "dimension"
    },
    "space-region-space-sm": {
      "$value": "{plx-ref.space-4u}",
      "$type": "dimension"
    },
    "space-region-space-md": {
      "$value": "{plx-ref.space-6u}",
      "$type": "dimension"
    },
    "space-region-space-lg": {
      "$value": "{plx-ref.space-8u}",
      "$type": "dimension"
    },
    "data-grid-row-height": {
      "$value": "{plx-ref.size-9u}",
      "$type": "dimension"
    },
    "table-row-height": {
      "$value": "{plx-ref.size-9u}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-data-grid-row-height instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "data-grid-font-size": {
      "$value": "{plx-ref.font-size-100}",
      "$type": "dimension"
    },
    "table-font-size": {
      "$value": "{plx-ref.font-size-100}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-data-grid-font-size instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    }
  }
}
