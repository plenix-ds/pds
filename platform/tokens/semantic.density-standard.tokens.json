{
  "$description": "semantic tokens written under :root,[data-plx-density=\"standard\"]",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/tokens/semantic.css",
      "selector": ":root,[data-plx-density=\"standard\"]",
      "opener": ":root,[data-plx-density=\"standard\"]{"
    }
  },
  "plx-sys": {
    "control-height-inline": {
      "$value": "{plx-ref.control-size-28px}",
      "$type": "dimension"
    },
    "control-icon-inline": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-toolbar": {
      "$value": "{plx-ref.control-size-28px}",
      "$type": "dimension"
    },
    "control-icon-toolbar": {
      "$value": "{plx-ref.size-20px}",
      "$type": "dimension"
    },
    "control-height-standard": {
      "$value": "{plx-ref.control-size-32px}",
      "$type": "dimension"
    },
    "control-icon-standard": {
      "$value": "{plx-ref.size-24px}",
      "$type": "dimension"
    },
    "control-height-prominent": {
      "$value": "{plx-ref.control-size-32px}",
      "$type": "dimension"
    },
    "control-icon-prominent": {
      "$value": "{plx-ref.size-24px}",
      "$type": "dimension"
    },
    "control-height-dialog": {
      "$value": "{plx-ref.control-size-36px}",
      "$type": "dimension"
    },
    "control-icon-dialog": {
      "$value": "{plx-ref.size-20px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "control-height-dialog-destructive": {
      "$value": "{plx-ref.control-size-36px}",
      "$type": "dimension"
    },
    "control-icon-dialog-destructive": {
      "$value": "{plx-ref.size-20px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): no role or component token has its values in every theme and density; the nearest is --plx-sys-control-icon-inline (16px instead of 20px when compact). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "card-grid-gap": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "grid-gutter": {
      "$value": "{plx-ref.grid-gutter-16px}",
      "$type": "dimension"
    },
    "page-margin-desktop": {
      "$value": "{plx-ref.grid-margin-24px}",
      "$type": "dimension"
    },
    "page-margin-wide": {
      "$value": "{plx-ref.grid-margin-32px}",
      "$type": "dimension"
    },
    "panel-filter-width": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension"
    },
    "panel-inspector-width": {
      "$value": "{plx-ref.size-360px}",
      "$type": "dimension"
    },
    "shell-nav-width": {
      "$value": "{plx-ref.size-240px}",
      "$type": "dimension"
    },
    "shell-nav-width-from-1440": {
      "$value": "{plx-ref.size-272px}",
      "$type": "dimension",
      "$description": "The navigation pane's starting width in a window 1440px wide up to 1919px (owner, issue 463 option C, step 2); grid.css sets --plx-sys-shell-nav-width to it there. Under 1440px the width is shell-nav-width."
    },
    "shell-nav-width-from-1920": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension",
      "$description": "The navigation pane's starting width in a window 1920px wide and wider (owner, issue 463 option C, step 2)."
    },
    "shell-nav-min-width": {
      "$value": "{plx-ref.size-140px}",
      "$type": "dimension"
    },
    "shell-nav-max-width": {
      "$value": "{plx-ref.size-320px}",
      "$type": "dimension"
    },
    "shell-pane-window-share": {
      "$value": "90%",
      "$type": "dimension",
      "$description": "The most of the window a pane or a table column may take when dragged (owner, issue 463, option C): 90% of the window for a pane of the shell, of the table for a column, then down to the 4px grid. A smaller limit the app or the component sets still applies."
    },
    "shell-splitter-step": {
      "$value": "{plx-ref.size-16px}",
      "$type": "dimension"
    },
    "shell-rail-below": {
      "$value": "{plx-ref.breakpoint-840px}",
      "$type": "dimension",
      "$description": "Medium window: the navigation is a rail below this width (Wide from here)",
      "$extensions": {
        "com.plenix": {
          "after": "      /* Medium window: the navigation is a rail below this width (Wide from here) */"
        },
        "plenix": {
          "source": {
            "platform": "Web",
            "verified": "2026-10-10",
            "type": "token",
            "level": "recommended by the source",
            "framework": "Material 3",
            "version": "unversioned (living guidelines)",
            "name": "Breakpoints: Expanded (Wide from)",
            "published": "840 dp",
            "url": "https://m3.material.io/foundations/layout/breakpoints/overview"
          }
        }
      }
    },
    "shell-inspector-overlay-below": {
      "$value": "{plx-ref.breakpoint-1024px}",
      "$type": "dimension",
      "$description": "the inspector collapses and opens over the main region below this width",
      "$extensions": {
        "com.plenix": {
          "after": "   /* the inspector collapses and opens over the main region below this width */"
        }
      }
    },
    "space-component-gap-xs": {
      "$value": "{plx-ref.space-4px}",
      "$type": "dimension"
    },
    "space-component-gap-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-component-gap-md": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-component-gap-lg": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-container-inset-sm": {
      "$value": "{plx-ref.space-12px}",
      "$type": "dimension"
    },
    "space-container-inset-md": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-container-inset-lg": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-pattern-stack-sm": {
      "$value": "{plx-ref.space-8px}",
      "$type": "dimension"
    },
    "space-pattern-stack-md": {
      "$value": "{plx-ref.space-16px}",
      "$type": "dimension"
    },
    "space-pattern-stack-lg": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-region-space-sm": {
      "$value": "{plx-ref.space-24px}",
      "$type": "dimension"
    },
    "space-region-space-md": {
      "$value": "{plx-ref.space-32px}",
      "$type": "dimension"
    },
    "space-region-space-lg": {
      "$value": "{plx-ref.space-48px}",
      "$type": "dimension"
    },
    "data-grid-row-height": {
      "$value": "{plx-ref.size-40px}",
      "$type": "dimension"
    },
    "table-row-height": {
      "$value": "{plx-ref.size-40px}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-data-grid-row-height instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    },
    "data-grid-font-size": {
      "$value": "{plx-ref.font-size-13}",
      "$type": "dimension"
    },
    "table-font-size": {
      "$value": "{plx-ref.font-size-13}",
      "$deprecated": "Not used by any page, application or the design spec (issue 882): use --plx-sys-data-grid-font-size instead (the same value in every theme and density). It keeps working, and is removed no earlier than the next minor release.",
      "$type": "dimension"
    }
  }
}
