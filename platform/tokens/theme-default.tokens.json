{
  "$description": "The default theme's foundations: the scales a theme decides (typefaces, weights, letter spacing, shape, lines, motion, opacity, the focus ring), the same in light and dark. Components and roles use only these, never the reference scales directly; the spacing, control heights, density, grid, breakpoints and layers are shared by every theme. Edit here; style-dictionary/build.mjs writes them into system/themes/default.css.",
  "$extensions": {
    "com.plenix": {
      "output": "platform/system/themes/default.css",
      "selector": ":root,[data-plx-theme=\"default\"]",
      "opener": ":root,[data-plx-theme=\"default\"]{"
    }
  },
  "plx-sys": {
    "typeface-sans": {
      "$value": "{plx-ref.font-sans}",
      "$type": "fontFamily",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* typography: the typefaces, weights and letter spacing of this theme */"
          ]
        }
      }
    },
    "typeface-sans-title": {
      "$value": "{plx-ref.font-sans-title}",
      "$type": "fontFamily",
      "$description": "The titles' typeface: the sans typeface, with Readex Pro for Arabic letters (owner, arabic-font-35)."
    },
    "typeface-mono": {
      "$value": "{plx-ref.font-mono}",
      "$type": "fontFamily"
    },
    "font-weight-regular": {
      "$value": "{plx-ref.font-weight-regular}",
      "$type": "fontWeight"
    },
    "font-weight-medium": {
      "$value": "{plx-ref.font-weight-medium}",
      "$type": "fontWeight"
    },
    "font-weight-semibold": {
      "$value": "{plx-ref.font-weight-semibold}",
      "$type": "fontWeight"
    },
    "font-weight-bold": {
      "$value": "{plx-ref.font-weight-bold}",
      "$type": "fontWeight"
    },
    "letter-spacing-tight": {
      "$value": "{plx-ref.letter-spacing-tight}",
      "$type": "dimension"
    },
    "letter-spacing-snug": {
      "$value": "{plx-ref.letter-spacing-snug}",
      "$type": "dimension"
    },
    "letter-spacing-wide": {
      "$value": "{plx-ref.letter-spacing-wide}",
      "$type": "dimension"
    },
    "letter-spacing-wider": {
      "$value": "{plx-ref.letter-spacing-wider}",
      "$type": "dimension"
    },
    "letter-spacing-caps": {
      "$value": "{plx-ref.letter-spacing-caps}",
      "$type": "dimension"
    },
    "letter-spacing-widest": {
      "$value": "{plx-ref.letter-spacing-widest}",
      "$type": "dimension"
    },
    "shape-none": {
      "$value": "{plx-ref.radius-none}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* shape: the corner radius scale (the radius roles, by density, point here) */"
          ]
        }
      }
    },
    "shape-2xs": {
      "$value": "{plx-ref.radius-xs}",
      "$type": "dimension"
    },
    "shape-xs": {
      "$value": "{plx-ref.radius-sm}",
      "$type": "dimension"
    },
    "shape-sm": {
      "$value": "{plx-ref.radius-md}",
      "$type": "dimension"
    },
    "shape-md": {
      "$value": "{plx-ref.radius-md}",
      "$type": "dimension"
    },
    "shape-lg": {
      "$value": "{plx-ref.radius-md}",
      "$type": "dimension"
    },
    "shape-xl": {
      "$value": "{plx-ref.radius-md}",
      "$type": "dimension"
    },
    "shape-mark": {
      "$value": "{plx-ref.radius-md}",
      "$type": "dimension",
      "$description": "Round marks: dots, tracks, markers, grabbers (6px since the owner's 2026-10-27 choice). Not pills: pills are 4px (radius-pill-4px). docs/adr/0008."
    },
    "shape-pill": {
      "$value": "{plx-sys.shape-mark}",
      "$type": "dimension",
      "$deprecated": "Renamed: use --plx-sys-shape-mark (no pill reads it; it shapes round marks; #240, docs/adr/0008). It keeps working and is removed in 2.0.0."
    },
    "border-width-thin": {
      "$value": "{plx-ref.border-width-100}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* lines: border widths and styles */"
          ]
        }
      }
    },
    "border-width-medium": {
      "$value": "{plx-ref.border-width-200}",
      "$type": "dimension"
    },
    "border-width-thick": {
      "$value": "{plx-ref.border-width-300}",
      "$type": "dimension"
    },
    "border-width-heavy": {
      "$value": "{plx-ref.border-width-400}",
      "$type": "dimension"
    },
    "border-style-solid": {
      "$value": "{plx-ref.border-style-solid}",
      "$type": "strokeStyle"
    },
    "border-style-dashed": {
      "$value": "{plx-ref.border-style-dashed}",
      "$type": "strokeStyle"
    },
    "motion-duration-quick": {
      "$value": "{plx-ref.motion-duration-quick}",
      "$type": "duration"
    },
    "motion-duration-instant": {
      "$value": "{plx-ref.motion-duration-instant}",
      "$type": "duration"
    },
    "motion-duration-fast": {
      "$value": "{plx-ref.motion-duration-fast}",
      "$type": "duration",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* motion: durations and easing (reduced motion still sets 0s) */"
          ]
        }
      }
    },
    "motion-duration-base": {
      "$value": "{plx-ref.motion-duration-base}",
      "$type": "duration"
    },
    "motion-duration-slow": {
      "$value": "{plx-ref.motion-duration-slow}",
      "$type": "duration"
    },
    "motion-duration-loop-fast": {
      "$value": "{plx-ref.motion-duration-loop-fast}",
      "$type": "duration"
    },
    "motion-duration-loop-base": {
      "$value": "{plx-ref.motion-duration-loop-base}",
      "$type": "duration"
    },
    "motion-duration-loop-slow": {
      "$value": "{plx-ref.motion-duration-loop-slow}",
      "$type": "duration"
    },
    "motion-ease-standard": {
      "$value": "{plx-ref.motion-ease-standard}",
      "$type": "cubicBezier"
    },
    "motion-ease-enter": {
      "$value": "{plx-ref.motion-ease-out}",
      "$type": "cubicBezier"
    },
    "motion-press-scale": {
      "$value": "{plx-ref.motion-scale-sm}",
      "$type": "number"
    },
    "motion-enter-scale": {
      "$value": "{plx-ref.motion-scale-md}",
      "$type": "number"
    },
    "motion-delay-stagger": {
      "$value": "{plx-ref.motion-delay-stagger}",
      "$type": "duration"
    },
    "opacity-low": {
      "$value": "{plx-ref.opacity-300}",
      "$type": "number",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* opacity levels */"
          ]
        }
      }
    },
    "opacity-mid": {
      "$value": "{plx-ref.opacity-500}",
      "$type": "number"
    },
    "opacity-high": {
      "$value": "{plx-ref.opacity-700}",
      "$type": "number"
    },
    "focus-ring-width": {
      "$value": "{plx-ref.border-width-200}",
      "$type": "dimension",
      "$extensions": {
        "com.plenix": {
          "before": [
            "  /* the focus ring */"
          ]
        }
      }
    },
    "focus-ring-offset": {
      "$value": { "value": 2, "unit": "px" },
      "$type": "dimension"
    }
  }
}
